{
  "name": "@agentpack/registry",
  "version": "0.7.0-dev",
  "private": true,
  "description": "AgentPack Registry — the web UI for AgentPacks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:deps": "tsc -b ../../packages/core ../../packages/db",
    "predev": "pnpm build:deps",
    "dev": "next dev -p 3030",
    "prebuild": "pnpm build:deps",
    "build": "next build",
    "start": "next start -p 3030",
    "pretypecheck": "pnpm build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: not configured'",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "pretest:coverage": "pnpm build:deps",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentpack/core": "workspace:*",
    "@agentpack/db": "workspace:*",
    "@auth/drizzle-adapter": "1.11.3",
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.31",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
