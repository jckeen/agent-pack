{
  "name": "agent-pack",
  "version": "0.7.0-dev",
  "private": true,
  "description": "AgentPack standard + AgentPack Registry — the compiler and governance layer for agent configuration.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @agentpack/core build && pnpm --filter @agentpack/db build && pnpm --filter @agentpack/connector build && pnpm --filter @agentpack/cli build && pnpm --filter @agentpack/registry build",
    "clean": "find . \\( -name dist -type d -o -name '*.tsbuildinfo' \\) -not -path '*/node_modules/*' -prune -exec rm -rf {} + && rm -rf apps/registry/.next",
    "dev": "pnpm --filter @agentpack/registry dev",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:coverage": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" test:coverage",
    "typecheck": "pnpm --filter @agentpack/core build && pnpm --filter @agentpack/db build && pnpm -r typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"apps/*/{app,components,lib}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml}\" --ignore-path .gitignore",
    "cli": "pnpm --filter @agentpack/cli exec agentpack",
    "seed:import": "tsx scripts/seed-import.ts",
    "db:push": "pnpm --filter @agentpack/db db:push",
    "db:generate": "pnpm --filter @agentpack/db db:generate",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<=0.24.2": ">=0.25.0",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "sharp@<0.35.0": ">=0.35.0",
      "next-auth@>=5.0.0-beta.0 <=5.0.0-beta.31": ">=5.0.0-beta.32",
      "@auth/core@>=0.1.0 <0.41.3": ">=0.41.3",
      "next-auth@>=5.0.0-beta.1 <=5.0.0-beta.31": ">=5.0.0-beta.32",
      "@auth/core@<=0.41.2": ">=0.41.3",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "hono@<4.12.34": ">=4.12.34",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "hono@>=3.8.0 <4.12.34": ">=4.12.34",
      "hono@>=4.7.0 <4.12.34": ">=4.12.34",
      "hono@>=4.12.0 <4.12.34": ">=4.12.34",
      "nanoid@<3.3.17": ">=3.3.17 <4"
    }
  }
}
