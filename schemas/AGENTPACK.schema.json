{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpack.dev/schemas/agentpack.schema.json",
  "title": "AgentPack Manifest",
  "type": "object",
  "required": ["agentpack", "metadata", "compatibility", "profiles", "atoms"],
  "$defs": {
    "atomPath": {
      "type": "string",
      "minLength": 1,
      "description": "Pack-relative source path. Mirrors the runtime `atomPathSchema` trust rules: no `~` home expansion, no absolute paths (POSIX or drive-letter), no `..` traversal segments, no Windows-reserved segment names, no NUL characters (#160, #168).",
      "allOf": [
        {
          "not": {
            "pattern": "^~"
          }
        },
        {
          "not": {
            "pattern": "\\u0000"
          }
        },
        {
          "not": {
            "pattern": "^([A-Za-z]:[\\\\/]|[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9¹²³]|[Ll][Pp][Tt][0-9¹²³])(\\.|[\\\\/]|$)"
          }
        }
      ]
    },
    "atomVariant": {
      "type": "object",
      "description": "Target-specific atom source (#133): exactly one of `path` (pack-relative file, same trust rules as `atom.path`) or `body` (inline content).",
      "properties": {
        "path": {
          "$ref": "#/$defs/atomPath"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["body"]
        }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "agentpack": {
      "type": "string",
      "pattern": "^1\\.\\d+"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "slug", "description", "version", "publisher"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "authors": {
          "type": "array"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object"
    },
    "permissions": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "profiles": {
      "type": "object"
    },
    "dependencies": {
      "type": "object"
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "description", "risk_level"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "instruction",
              "rule",
              "skill",
              "hook",
              "command",
              "subagent",
              "mcp_server",
              "plugin",
              "workflow",
              "context_pack",
              "template",
              "eval"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/atomPath"
          },
          "risk_level": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Inline default body — alternative to `path` (#133)."
          },
          "variants": {
            "type": "object",
            "description": "Per-target source/body overrides keyed by target platform; the atom keeps one id while each target compiles its own variant (#133). May be empty when the atom carries a default `path`/`body`; when variants is the atom's ONLY source it must have at least one entry — enforced by the atom-level `anyOf`, matching the runtime superRefine (#166).",
            "properties": {
              "claude-code": {
                "$ref": "#/$defs/atomVariant"
              },
              "codex": {
                "$ref": "#/$defs/atomVariant"
              },
              "cursor": {
                "$ref": "#/$defs/atomVariant"
              },
              "chatgpt": {
                "$ref": "#/$defs/atomVariant"
              },
              "generic": {
                "$ref": "#/$defs/atomVariant"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": ["path"]
              },
              {
                "required": ["body"]
              },
              {
                "required": ["variants"],
                "properties": {
                  "variants": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            ]
          },
          {
            "not": {
              "required": ["path", "body"]
            }
          }
        ]
      }
    },
    "exports": {
      "type": "object"
    },
    "adapters": {
      "type": "object"
    }
  }
}
